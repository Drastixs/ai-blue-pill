# Pi parent. openai-codex uses Pi's ChatGPT OAuth login (`pi`, then `/login`).
AIBP_PARENT_PROVIDER=openai-codex
AIBP_PARENT_MODEL=gpt-5.6-sol
AIBP_PARENT_THINKING=medium
AIBP_CHILD_PROVIDER=codex

# Optional custom OpenAI-compatible parent endpoint. When set, also choose a
# custom provider name above (for example aibp-openai) and supply its API key.
# AIBP_PARENT_BASE_URL=https://example.com/v1
# AIBP_PARENT_API_KEY=
# AIBP_PARENT_API=openai-responses
# AIBP_PARENT_REASONING=true

# Optional model override for the Codex child. Empty uses the Codex CLI default.
AIBP_CODEX_MODEL=
