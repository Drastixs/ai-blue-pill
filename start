#!/usr/bin/env sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ ! -f "$project_dir/dist/src/cli.js" ]; then
  echo "AI Blue Pill has not been built." >&2
  echo "Run: cd $project_dir && npm install && npm run build" >&2
  exit 1
fi

exec node "$project_dir/dist/src/cli.js" start "$@"
